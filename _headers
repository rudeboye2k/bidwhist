# Cloudflare static-asset headers. https://developers.cloudflare.com/workers/static-assets/headers/

# Always revalidate (ETag → cheap 304s) so every deploy reaches players at once.
# Script/style URLs in index.html also carry a ?v= tag to bust old caches.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate

# Baseline security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
